{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash vercel-build.sh",
  "outputDirectory": "build/web",
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "x-forwarded-proto",
          "value": "http"
        }
      ],
      "destination": "https://kalasthali.co/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/product",
      "has": [{"type": "query", "key": "code", "value": "(?<productCode>[A-Za-z0-9_-]+)"}],
      "destination": "/prerendered/:productCode.html"
    },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/privacy-policy", "destination": "/privacy-policy/index.html" },
    { "source": "/terms-of-service", "destination": "/terms-of-service/index.html" },
    { "source": "/refund-policy", "destination": "/refund-policy/index.html" },
    { "source": "/collections", "destination": "/flutter.html" },
    { "source": "/collection", "destination": "/flutter.html" },
    { "source": "/product", "destination": "/flutter.html" },
    { "source": "/cart", "destination": "/flutter.html" },
    { "source": "/checkout", "destination": "/flutter.html" },
    { "source": "/account", "destination": "/flutter.html" },
    { "source": "/admin", "destination": "/flutter.html" },
    { "source": "/settings", "destination": "/flutter.html" },
    { "source": "/reset-password", "destination": "/flutter.html" },
    {
      "source": "/api/sitemap",
      "destination": "/sitemap.xml"
    }
  ]
}
